APP_MODE=demo
ADMIN_TOKEN=
POSTGRES_PASSWORD=
DATABASE_URL=Host=postgres;Database=autopost;Username=autopost;Password=REPLACE_ME
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=zai-org/GLM-5.3-Flash
OPENAI_API_KEY=
# Optional semantic grouping; verify model access before enabling. Uses analysis daily budget.
EMBEDDING_MODEL=
X_BEARER_TOKEN=
X_USER_ACCESS_TOKEN=
# Optional OAuth2 refresh support; obtain offline.access authorization first.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REFRESH_TOKEN=
# Compose sets /oauth/x.json; non-Compose workers need an absolute private persistent path.
X_OAUTH_STATE_PATH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_DOMAIN=auto-post.maxson.cc
# IP of the Docker bridge gateway used by the host Nginx connection
TRUSTED_PROXY=172.30.86.1
KEYS_PATH=/keys

# PostgreSQL default; mysql requires a dedicated database and verified TLS for remote hosts.
DATABASE_PROVIDER=postgres
BINANCE_SQUARE_OPENAPI_KEY=
